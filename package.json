{
  "name": "buurtapps-linktracker",
  "version": "1.0.0",
  "private": true,
  "description": "Centrale linktracking voor BuurtApps (ZeistApp, GooiseMerenApp en volgende apps)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "ADMIN_API_KEY=test-admin-sleutel FLUSH_INTERVAL_MS=50 node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "parse5": "^8.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0"
  }
}
